{
  "name": "card-optimizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "보유 신용카드의 실적·한도·혜택을 계산해 최적 결제 카드를 추천하는 개인용 PWA (MVP)",
  "scripts": {
    "dev": "vite --host",
